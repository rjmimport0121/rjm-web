// Configuración de Cloudflare Workers.
// La web es estática: Cloudflare sirve los archivos del repositorio tal cual.
// worker.js solo atiende las rutas de "run_worker_first" (páginas de producto
// para Google y sitemap.xml); ver los comentarios al inicio de worker.js.
{
  "name": "rjm-web",
  "main": "worker.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/producto/*", "/sitemap.xml"]
  },
  "vars": {
    // Datos públicos (los mismos de js/config.js). Nunca pongas aquí la service_role.
    "SUPABASE_URL": "https://zdlurhdnsgtllgfhixic.supabase.co",
