// Configuración de Cloudflare Workers.
// La web es estática: Cloudflare sirve los archivos del repositorio tal cual.
// worker.js solo recibe lo que no es un archivo del repositorio: las páginas de
// producto para Google y sitemap.xml (ver los comentarios al inicio de worker.js).
// No uses "run_worker_first" como lista: el build de Cloudflare usa Wrangler 3,
// que solo la acepta como true/false, y el despliegue falla.
{
  "name": "rjm-web",
  "main": "worker.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "vars": {
    // Datos públicos (los mismos de js/config.js). Nunca pongas aquí la service_role.
    "SUPABASE_URL": "https://zdlurhdnsgtllgfhixic.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpkbHVyaGRuc2d0bGxnZmhpeGljIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM1ODY2NDcsImV4cCI6MjEwOTE2MjY0N30.13BCHmOsh7HH4m6G5MBtq5WxGa3DdRMHJP23F8_XDBM",
    "WHATSAPP": "51956543522"
  }
}
